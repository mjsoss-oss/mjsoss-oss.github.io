navigator.geolocation&&navigator.geolocation.watchPosition(function(pos){
  var la=pos.coords.latitude,ln=pos.coords.longitude,ac=pos.coords.accuracy;
  if(myMarker){myMarker.setLatLng([la,ln]);myCircle.setLatLng([la,ln]);myCircle.setRadius(ac)}
  else{
    myCircle=L.circle([la,ln],{radius:ac,color:'#3b82f6',fillColor:'#3b82f6',fillOpacity:0.15,weight:1}).addTo(map);
    myMarker=L.circleMarker([la,ln],{radius:9,color:'white',fillColor:'#3b82f6',fillOpacity:1,weight:3}).addTo(map);
  }
},null,{enableHighAccuracy:true,maximumAge:3000});
var locCtrl=L.control({position:'bottomright'});
locCtrl.onAdd=function(){
  var btn=L.DomUtil.create('button','');
  btn.innerHTML='📍';
  btn.style.cssText='width:42px;height:42px;background:white;border:2px solid #ccc;border-radius:10px;font-size:20px;cursor:pointer;box-shadow:0 2px 8px rgba(0,0,0,0.3);margin-bottom:60px';
  btn.onclick=function(){myMarker?map.setView(myMarker.getLatLng(),16):navigator.geolocation.getCurrentPosition(function(p){map.setView([p.coords.latitude,p.coords.longitude],16)})};
  return btn;
};
locCtrl.addTo(map);
function makeIcon(d){
  var isDone=doneMap[d.id],seq=orderMap[d.id],isOrd=currentTab==='order';
  var bg,label;
  if(isOrd){bg=seq?'#f97316':'#6b7280';label=seq?String(seq):'·'}
  else{bg=isDone?'#22c55e':(seq?'#ef4444':'#6b7280');label=isDone?'✓':(seq?String(seq):'·')}
  var fs=String(label).length>3?'7px':String(label).length>2?'9px':'11px';
  var size=isOrd?28:(seq?34:22);
  return L.divIcon({
    className:'',
    html:'<div style="background:'+bg+';color:white;border-radius:50%;width:'+size+'px;height:'+size+'px;display:flex;align-items:center;justify-content:center;font-size:'+fs+';font-weight:900;border:2px solid white;box-shadow:0 2px 6px rgba(0,0,0,0.4)">'+label+'</div>',
    iconSize:[size,size],iconAnchor:[size/2,size/2],popupAnchor:[0,-size/2-4]
  });
}
function makePopup(d){
  var isDone=doneMap[d.id],seq=orderMap[d.id];
  var qtyTag=d.qty>1?'<div class="qty-tag">📦 수량 '+d.qty+'개</div>':'';
  var cashTag=d.cashon?'<span class="cash-tag">💰 착불</span>':'';
  return '<div class="info-popup">'
    +'<div class="pnum '+(isDone?'':'undone')+'">'+(seq?seq+'번':'')+' '+(isDone?'✅':'📦')+'</div>'
    +qtyTag+(cashTag?'<div>'+cashTag+'</div>':'')
    +'<div class="pname">'+d.name+'</div>'
    +'<div class="paddr">'+d.addr+'</div>'
    +(d.product?'<div class="pprod">'+d.product+'</div>':'')
    +'<div class="pmeta">📞 '+(d.phone||'-')+' &nbsp;·&nbsp; 송장 <b>'+String(d.tracking).slice(-4)+'</b></div>'
    +'<a class="kakao-btn" href="https://map.kakao.com/?q='+encodeURIComponent(d.addr)+'" target="_blank">🗺️ 카카오맵으로 보기</a>'
    +'<button class="done-btn '+(isDone?'undo':'')+'\" onclick="toggleDone(\''+d.id+'\')">'+(isDone?'↩ 완료 취소':'✅ 배송 완료')+'</button>'
    +'</div>';
}
function putMarker(d,coord){
  if(markerMap[d.id])map.removeLayer(markerMap[d.id]);
  var m=L.marker([coord.lat,coord.lng],{icon:makeIcon(d)}).addTo(map);
  m.bindPopup(makePopup(d),{maxWidth:290});
  (function(dd){m.on('click',function(){onMarkerClick(dd)})})(d);
  markerMap[d.id]=m;
}
function refreshIcons(){
  D.forEach(function(d){
    if(markerMap[d.id]){markerMap[d.id].setIcon(makeIcon(d));markerMap[d.id].setPopupContent(makePopup(d))}
  });
}
function onMarkerClick(d){
  if(currentTab==='order'){
    if(isLocked){alert('🔒 순번이 확정되어 변경할 수 없습니다.');return}
    orderHistory.push(JSON.parse(JSON.stringify(orderMap)));
    if(orderMap[d.id]){
      delete orderMap[d.id];
      var s=Object.entries(orderMap).sort(function(a,b){return a[1]-b[1]});
      orderMap={};s.forEach(function(e,i){orderMap[e[0]]=i+1});
      nextSeq=s.length+1;
    }else{orderMap[d.id]=nextSeq++}
    save(KEY_ORDER,orderMap);refreshIcons();updHint();
  }else{
    if(markerMap[d.id])markerMap[d.id].openPopup();
  }
}
window.toggleDone=function(id){
  doneMap[id]=!doneMap[id];save(KEY_DONE,doneMap);
  var d=D.find(function(x){return x.id===id});
  if(d&&markerMap[id]){markerMap[id].setIcon(makeIcon(d));markerMap[id].setPopupContent(makePopup(d))}
  updateCount();
};
function updateCount(){
  var dn=Object.values(doneMap).filter(Boolean).length;
  document.getElementById('count').textContent='완료 '+dn+'/'+D.length+'건';
}
function updHint(){
  var n=Object.keys(orderMap).length;
  document.getElementById('order-hint').textContent=isLocked?'🔒 순번 확정됨':(n?n+'개 순번 지정됨':'핀을 탭해서 순번 지정');
}
function goTab(t){
  currentTab=t;
  ['map','order','load'].forEach(function(id){
    var b=document.getElementById('tab-'+id);if(b)b.classList.toggle('active',id===t);
  });
  document.getElementById('order-bar').classList.toggle('show',t==='order');
  document.getElementById('order-badge').classList.toggle('show',t==='order');
  document.getElementById('load-view').classList.toggle('show',t==='load');
  if(t==='load')renderLoad();
  refreshIcons();
}
document.getElementById('btn-undo').onclick=function(){
  if(isLocked){alert('🔒 확정된 순번입니다.');return}
  if(!orderHistory.length)return;
  orderMap=orderHistory.pop();
  var seqs=Object.values(orderMap).filter(function(v){return typeof v==='number'});
  nextSeq=seqs.length?Math.max.apply(null,seqs)+1:1;
  save(KEY_ORDER,orderMap);refreshIcons();updHint();
};
document.getElementById('btn-reset').onclick=function(){
  if(isLocked){alert('🔒 확정된 순번입니다.');return}
  if(!confirm('순번을 모두 초기화할까요?'))return;
  orderHistory.push(JSON.parse(JSON.stringify(orderMap)));
  orderMap={};nextSeq=1;save(KEY_ORDER,orderMap);refreshIcons();updHint();
};
document.getElementById('btn-save').onclick=function(){
  if(isLocked){alert('🔒 이미 확정된 순번입니다.');return}
  var n=Object.keys(orderMap).length;
  if(!n){alert('지정된 순번이 없습니다.');return}
  if(!confirm(n+'개 순번을 저장·확정합니다.\n저장 후 변경 불가합니다.\n계속할까요?'))return;
  isLocked=true;save(KEY_ORDER,orderMap);save(KEY_LOCKED,true);
  refreshIcons();updHint();
  alert('🔒 순번 확정!\n적재 탭에서 싣는 순서를 확인하세요.');
  goTab('map');
};
var loadSortMode='tracking';
function renderLoad(){
  var assigned=D.filter(function(d){return orderMap[d.id]});
  var unassigned=D.filter(function(d){return !orderMap[d.id]});
  if(loadSortMode==='tracking'){
    assigned.sort(function(a,b){return String(b.tracking).slice(-4).localeCompare(String(a.tracking).slice(-4))});
  }else{
    assigned.sort(function(a,b){return orderMap[b.id]-orderMap[a.id]});
  }
  var h='';
  if(!assigned.length){
    h='<div style="padding:40px;text-align:center;color:#64748b">순번 지정 후 저장해주세요.</div>';
  }else{
    h+='<div style="padding:8px 12px;background:#0a0c10;border-bottom:1px solid #1e2130;display:flex;align-items:center;justify-content:space-between">'
      +'<span style="font-size:11px;color:#64748b">총 '+assigned.length+'개</span>'
      +'<div style="display:flex;gap:6px">'
      +'<button onclick="setLoadSort(\'tracking\')" style="padding:4px 10px;border-radius:6px;border:none;font-size:11px;font-weight:700;cursor:pointer;background:'+(loadSortMode==='tracking'?'#facc15':'#2a2d3a')+';color:'+(loadSortMode==='tracking'?'#1a1000':'#94a3b8')+'">송장번호순</button>'
      +'<button onclick="setLoadSort(\'order\')" style="padding:4px 10px;border-radius:6px;border:none;font-size:11px;font-weight:700;cursor:pointer;background:'+(loadSortMode==='order'?'#22c55e':'#2a2d3a')+';color:'+(loadSortMode==='order'?'white':'#94a3b8')+'">적재순서</button>'
      +'</div></div>';
    assigned.forEach(function(d,i){
      var delivSeq=orderMap[d.id];
      var isDone=doneMap[d.id];
      var t4=String(d.tracking).slice(-4);
      var loadNum=loadSortMode==='order'?(i+1):'';
      var numBg=loadSortMode==='order'&&i===0?'#facc15':'#2a2d3a';
      var numColor=loadSortMode==='order'&&i===0?'#1a1000':'#f1f5f9';
      h+='<div class="load-item" style="'+(isDone?'opacity:0.4;':'')+'">'
        +'<div class="load-num" style="background:'+numBg+';color:'+numColor+'">'
        +(loadSortMode==='tracking'?('<b style="font-size:15px;color:#facc15">'+t4+'</b>'):loadNum)
        +'</div>'
        +'<div class="load-info">'
          +'<div class="load-name">'+d.name+(d.cashon?'<span class="badge cash">착불</span>':'')+(d.qty>1?'<span class="badge qty">×'+d.qty+'</span>':'')+'</div>'
          +'<div class="load-addr">'+d.addr+'</div>'
          +(d.product?'<div class="load-prod">'+d.product+'</div>':'')
        +'</div>'
        +'<div class="load-right">'
        +'<div class="load-seq">배송<br><b>'+delivSeq+'번</b></div>'
        +(loadSortMode==='order'?'<div style="font-size:11px;color:#facc15;font-weight:700;margin-top:2px">'+t4+'</div>':'')
        +'</div>'
        +'</div>';
    });
    if(unassigned.length){
      h+='<div style="padding:8px 16px;font-size:11px;color:#f97316;background:#1a0e00;border-top:2px solid #f97316">⚠️ 순번 미지정 '+unassigned.length+'건</div>';
      unassigned.forEach(function(d){
        h+='<div class="load-item"><div class="load-num" style="background:#2a1a00;color:#f97316">?</div>'
          +'<div class="load-info"><div class="load-name">'+d.name+'</div>'
          +'<div class="load-addr">'+d.addr+'</div></div>'
          +'<div class="load-right"><div style="color:#f97316;font-size:11px">미지정</div></div></div>';
      });
    }
  }
  document.getElementById('load-list').innerHTML=h;
}
window.setLoadSort=function(mode){loadSortMode=mode;renderLoad();};
async function geocode(addr){
  if(coordCache[addr])return coordCache[addr];
  try{
    var r=await fetch('https://dapi.kakao.com/v2/local/search/address.json?query='+encodeURIComponent(addr),{headers:{'Authorization':'KakaoAK '+KK}});
    var j=await r.json();
    if(j.documents&&j.documents[0]){
      var c={lat:parseFloat(j.documents[0].y),lng:parseFloat(j.documents[0].x)};
      coordCache[addr]=c;save(KEY_COORDS,coordCache);return c;
    }
  }catch(e){}
  return null;
}
async function loadMarkers(){
  var sb=document.getElementById('status');sb.style.display='block';
  var done=0;
  for(var i=0;i<D.length;i++){
    var d=D[i],c=await geocode(d.addr);
    done++;sb.textContent='주소 변환 중 '+done+'/'+D.length+' — '+d.name;
    if(c)putMarker(d,c);
    await new Promise(function(r){setTimeout(r,80)});
  }
  sb.style.display='none';updateCount();
  var coords=Object.values(coordCache);
  if(coords.length>1)map.fitBounds(L.latLngBounds(coords.map(function(c){return[c.lat,c.lng]})),{padding:[40,40]});
}
initState();updateCount();updHint();loadMarkers();
</script>
</body>
</html>
